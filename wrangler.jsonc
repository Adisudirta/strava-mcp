{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "strava-mcp",
	"compatibility_date": "2026-04-22",
	"main": "src/index.ts",
	"minify": true,
	"vars": {
		// Override this in .dev.vars for local dev: REDIRECT_URI=http://localhost:8787/auth/callback
		"REDIRECT_URI": "https://strava-mcp.workers.dev/auth/callback"
	},
	"kv_namespaces": [
		{
			"binding": "STRAVA_KV",
			"id": "c2be110f2c85490f9f77ae407310411c",
			"remote": true
		}
	]
}